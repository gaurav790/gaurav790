class PneumoniaDetectionModel(nn.Module):
    def __init__(self, num_classes=2, pretrained=True):
        super(PneumoniaDetectionModel, self).__init__()
        
        # Load pre-trained ResNet50
        self.backbone = models.resnet50(pretrained=pretrained)
        
        # Freeze early layers (optional - can be fine-tuned later)
        for param in list(self.backbone.parameters())[:-20]:  # Freeze all but last 20 parameters
            param.requires_grad = False
        
        # Get the number of features from the backbone
        num_features = self.backbone.fc.in_features
        
        # Replace the final fully connected layer
        self.backbone.fc = nn.Sequential(
            nn.Dropout(0.5),
            nn.Linear(num_features, 512),
            nn.ReLU(inplace=True),
            nn.Dropout(0.3),
            nn.Linear(512, 128),
            nn.ReLU(inplace=True),
            nn.Linear(128, num_classes)
        )
    
    def forward(self, x):
        return self.backbone(x)

# Initialize the model
