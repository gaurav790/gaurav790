def plot_confusion_matrix(cm, class_names):
    """Plot confusion matrix with detailed annotations."""
    
    plt.figure(figsize=(8, 6))
    
    # Create heatmap
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', 
                xticklabels=class_names, yticklabels=class_names,
                cbar_kws={'label': 'Number of Samples'})
    
    plt.title('Confusion Matrix', fontsize=16, fontweight='bold')
    plt.xlabel('Predicted Label', fontsize=12, fontweight='bold')
    plt.ylabel('True Label', fontsize=12, fontweight='bold')
    
    # Add percentage annotations
    total = np.sum(cm)
    for i in range(cm.shape[0]):
        for j in range(cm.shape[1]):
            percentage = cm[i, j] / total * 100
            plt.text(j + 0.5, i + 0.7, f'({percentage:.1f}%)', 
                    ha='center', va='center', fontsize=10, color='gray')
    
    plt.tight_layout()
    plt.show()
    
    # Print detailed analysis
    print("\nConfusion Matrix Analysis:")
    print(f"True Negatives (Normal correctly identified): {cm[0,0]}")
    print(f"False Positives (Normal misclassified as Pneumonia): {cm[0,1]}")
    print(f"False Negatives (Pneumonia misclassified as Normal): {cm[1,0]}")
    print(f"True Positives (Pneumonia correctly identified): {cm[1,1]}")
    
    # Calculate per-class metrics
    sensitivity = cm[1,1] / (cm[1,1] + cm[1,0])  # Recall for Pneumonia
    specificity = cm[0,0] / (cm[0,0] + cm[0,1])  # Recall for Normal
    
    print(f"\nClinical Metrics:")
    print(f"Sensitivity (Pneumonia Detection Rate): {sensitivity:.4f}")
    print(f"Specificity (Normal Detection Rate): {specificity:.4f}")

