def generate_gradcam_visualizations(model, test_dataset, device, num_samples=4):
    """Generate Grad-CAM visualizations for model explainability."""
    
    if not GRADCAM_AVAILABLE:
        print("Grad-CAM not available. Install with: pip install grad-cam")
        print("\nGrad-CAM Explanation:")
        print("Grad-CAM (Gradient-weighted Class Activation Mapping) helps explain model decisions by:")
        print("- Highlighting important regions in the input image")
        print("- Showing where the model 'looks' when making predictions")
        print("- Providing interpretability for medical professionals")
        print("- Building trust in AI-assisted diagnosis")
        return
    
    # Select target layer (last convolutional layer of ResNet50)
    target_layers = [model.backbone.layer4[-1].conv3]
    
    # Initialize Grad-CAM
    cam = GradCAM(model=model, target_layers=target_layers, use_cuda=torch.cuda.is_available())
    
    # Get random samples
    indices = random.sample(range(min(len(test_dataset), 100)), num_samples)
    
    fig, axes = plt.subplots(2, num_samples, figsize=(16, 8))
    fig.suptitle('Grad-CAM Visualizations: Model Attention Maps', fontsize=16, fontweight='bold')
    
    model.eval()
    
    for idx, sample_idx in enumerate(indices):
        # Load original image for visualization
        img_path = test_dataset.image_paths[sample_idx]
        original_image = cv2.imread(img_path)
        original_image = cv2.cvtColor(original_image, cv2.COLOR_BGR2RGB)
        original_image = cv2.resize(original_image, (224, 224))
        
        # Get preprocessed image
        input_tensor, true_label = test_dataset[sample_idx]
        input_tensor = input_tensor.unsqueeze(0).to(device)
        
        # Get prediction
        with torch.no_grad():
            output = model(input_tensor)
            probabilities = F.softmax(output, dim=1)
            predicted_class = torch.argmax(output, dim=1).item()
            confidence = probabilities[0][predicted_class].item()
        
        # Generate Grad-CAM
        targets = [ClassifierOutputTarget(predicted_class)]
        grayscale_cam = cam(input_tensor=input_tensor, targets=targets)
        grayscale_cam = grayscale_cam[0, :]
        
        # Normalize original image for visualization
        rgb_img = original_image / 255.0
        
        # Create visualization
        visualization = show_cam_on_image(rgb_img, grayscale_cam, use_rgb=True)
        
        # Plot original image
        axes[0, idx].imshow(original_image)
        axes[0, idx].set_title(f'Original\\nTrue: {config.CLASS_NAMES[true_label]}', fontweight='bold')
        axes[0, idx].axis('off')
        
        # Plot Grad-CAM visualization
        axes[1, idx].imshow(visualization)
        pred_color = 'green' if predicted_class == true_label else 'red'
        axes[1, idx].set_title(f'Grad-CAM\\nPred: {config.CLASS_NAMES[predicted_class]} ({confidence:.3f})', 
                              fontweight='bold', color=pred_color)
        axes[1, idx].axis('off')
    
    plt.tight_layout()
    plt.show()
    
    print("\nGrad-CAM Analysis:")
    print("- Red/warm areas indicate regions the model focuses on for its prediction")
    print("- For pneumonia cases, the model should focus on lung areas with abnormalities")
    print("- For normal cases, attention should be more distributed or on healthy lung regions")

