### Transfer Learning Strategy

We'll use **ResNet50** pre-trained on ImageNet as our base model. This approach offers several advantages:

1. **Feature Extraction**: Pre-trained features capture low-level patterns (edges, textures) useful for medical images
2. **Faster Training**: Reduces training time compared to training from scratch
3. **Better Performance**: Especially beneficial when working with limited medical data
4. **Proven Architecture**: ResNet50 has demonstrated excellent performance across various image classification tasks

### Model Architecture
- **Backbone**: ResNet50 (frozen early layers)
- **Custom Head**: Fully connected layers for binary classification
- **Activation**: Sigmoid for binary probability output# Define data augmentation strategies using Albumentations
def get_transforms(split='train'):
    """Get appropriate transforms for each dataset split."""
    
    if split == 'train':
        # Training transforms with augmentation
        return A.Compose([
            A.Resize(config.IMAGE_SIZE, config.IMAGE_SIZE),
            A.HorizontalFlip(p=0.5),
            A.Rotate(limit=15, p=0.5),
            A.RandomBrightnessContrast(brightness_limit=0.2, contrast_limit=0.2, p=0.5),
            A.ShiftScaleRotate(shift_limit=0.1, scale_limit=0.1, rotate_limit=15, p=0.5),
            A.GaussNoise(var_limit=(10.0, 50.0), p=0.3),
            A.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
            ToTensorV2()
        ])
    else:
        # Validation/Test transforms without augmentation
        return A.Compose([
            A.Resize(config.IMAGE_SIZE, config.IMAGE_SIZE),
            A.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
            ToTensorV2()
        ])

print("Data augmentation transforms defined!")
print("\nAugmentation Strategy:")
print("- Horizontal Flip: Increases data diversity")
print("- Rotation (±15°): Simulates different patient positioning")
print("- Brightness/Contrast: Accounts for different X-ray machine settings")
print("- Gaussian Noise: Improves model robustness")
print("- ImageNet normalization: Leverages pre-trained model knowledge")# Custom Dataset class with data augmentation
class ChestXrayDataset(Dataset):
    def __init__(self, data_path, split='train', transform=None):
        self.data_path = data_path
        self.split = split
        self.transform = transform
        
        # Load file paths and labels
        self.image_paths = []
        self.labels = []
        
        # Class mapping
        self.class_to_idx = {'normal': 0, 'pneumonia': 1}
        
        # Load images from both classes
        for class_name in ['normal', 'pneumonia']:
            class_path = os.path.join(data_path, split, class_name)
            if os.path.exists(class_path):
                for img_name in os.listdir(class_path):
                    if img_name.lower().endswith(('.png', '.jpg', '.jpeg')):
                        self.image_paths.append(os.path.join(class_path, img_name))
                        self.labels.append(self.class_to_idx[class_name])
    
    def __len__(self):
        return len(self.image_paths)
    
    def __getitem__(self, idx):
        # Load image
        img_path = self.image_paths[idx]
        image = cv2.imread(img_path)
        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
        
        # Get label
        label = self.labels[idx]
        
        # Apply transformations
        if self.transform:
            augmented = self.transform(image=image)
            image = augmented['image']
        
        return image, label

print("Custom Dataset class created successfully!")# Visualize class distribution
def plot_class_distribution(dataset_info):
    """Plot class distribution across train, validation, and test sets."""
    fig, axes = plt.subplots(1, 3, figsize=(15, 5))
    fig.suptitle('Class Distribution Across Dataset Splits', fontsize=16, fontweight='bold')
    
    colors = ['#3498db', '#e74c3c']  # Blue for Normal, Red for Pneumonia
    
    for idx, (split, classes) in enumerate(dataset_info.items()):
        class_names = list(classes.keys())
        counts = list(classes.values())
        
        bars = axes[idx].bar(class_names, counts, color=colors)
        axes[idx].set_title(f'{split.capitalize()} Set', fontweight='bold')
        axes[idx].set_ylabel('Number of Images')
        
        # Add value labels on bars
        for bar, count in zip(bars, counts):
            height = bar.get_height()
            axes[idx].text(bar.get_x() + bar.get_width()/2., height + 0.01*max(counts),
                         f'{count}', ha='center', va='bottom', fontweight='bold')
    
    plt.tight_layout()
    plt.show()

# Plot class distribution
plot_class_distribution(dataset_info)# Function to explore dataset structure and count images
def explore_dataset(data_path):
    """Explore the dataset structure and count images in each category."""
    dataset_info = {}
    
    for split in ['train', 'val', 'test']:
        split_path = os.path.join(data_path, split)
        if os.path.exists(split_path):
            dataset_info[split] = {}
            for class_name in ['normal', 'pneumonia']:
                class_path = os.path.join(split_path, class_name)
                if os.path.exists(class_path):
                    count = len([f for f in os.listdir(class_path) 
                               if f.lower().endswith(('.png', '.jpg', '.jpeg'))])
                    dataset_info[split][class_name] = count
                else:
                    dataset_info[split][class_name] = 0
    
    return dataset_info

